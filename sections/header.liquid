{% comment %}
  Header section optimized for performance and maintainability
  Includes: Navigation, Search, Cart, Account access
{% endcomment %}

{% comment %} CSS and JS dependencies {% endcomment %}
{{ 'component-aliexpress-header.css' | asset_url | stylesheet_tag }}

<noscript>
  {{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
  {{ 'component-search.css' | asset_url | stylesheet_tag }}
  {{ 'component-menu-drawer.css' | asset_url | stylesheet_tag }}
  {{ 'component-cart-notification.css' | asset_url | stylesheet_tag }}
  {{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
  {{ 'component-aliexpress-header.css' | asset_url | stylesheet_tag }}
</noscript>

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'component-aliexpress-header.js' | asset_url }}" defer="defer"></script>

<style>
  header-drawer {
    justify-self: start;
    margin-left: -1.2rem;
  }

  .header__heading-logo {
    max-width: {{ settings.logo_width }}px;
  }

  @media screen and (max-width: 768px) {
    .header__heading-logo {
      max-width: {{ settings.mobile_logo_width }}px;
    }
  }

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo {
      width: 75%;
    }
  {%- endif -%}

  @media screen and (min-width: 990px) {
    header-drawer {
      display: none;
    }
  }

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }

  .list-menu__item--link {
    text-decoration: none;
    padding: 1rem 0;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding: 0.5rem 0;
    }
  }
</style>

{% comment %} Section specific styles {% endcomment %}
{%- style -%}
  #shopify-section-{{ section.id }} .header-wrapper {
    padding: 5px 0;
  }
  
  .header {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  .section-header {
    position: sticky;
    margin-bottom: 0;
  }

  @media screen and (min-width: 990px) {
    .header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* CLS Optimization: More accurate header height estimation to prevent layout shift */
  {% comment %} Account for logo height, navigation, padding, and borders more accurately {% endcomment %}
  {% assign base_mobile_height = 50 %}
  {% assign base_desktop_height = 55 %}
  
  {% comment %} Add padding with full values (not half) {% endcomment %}
  {% assign estimated_mobile_height = section.settings.padding_top | plus: section.settings.padding_bottom | plus: base_mobile_height %}
  {% assign estimated_desktop_height = section.settings.padding_top | plus: section.settings.padding_bottom | plus: base_desktop_height %}
  
  {% comment %} Account for announcement bar if present {% endcomment %}
  {% if section.settings.enable_sticky_header and sections.announcement-bar %}
    {% assign estimated_mobile_height = estimated_mobile_height | plus: 40 %}
    {% assign estimated_desktop_height = estimated_desktop_height | plus: 45 %}
  {% endif %}
  
  :root {
    --header-height: {{ estimated_mobile_height }}px;
    --header-height-initial: {{ estimated_mobile_height }}px;
  }

  @media screen and (min-width: 990px) {
    :root {
      --header-height: {{ estimated_desktop_height }}px;
      --header-height-initial: {{ estimated_desktop_height }}px;
    }
  }

  /* CLS Optimization: Ensure header takes up space immediately */
  .section-header {
    min-height: var(--header-height-initial);
  }
{%- endstyle -%}

{% comment %} SVG icons {% endcomment %}
<svg xmlns="http://www.w3.org/2000/svg" class="hidden">
  <symbol id="icon-search" viewbox="0 0 18 19" fill="none">
    <path fill-rule="evenodd" clip-rule="evenodd" d="M11.03 11.68A5.784 5.784 0 112.85 3.5a5.784 5.784 0 018.18 8.18zm.26 1.12a6.78 6.78 0 11.72-.7l5.4 5.4a.5.5 0 11-.71.7l-5.41-5.4z" fill="currentColor"/>
  </symbol>

  <symbol id="icon-reset" class="icon icon-close" fill="none" viewBox="0 0 18 18" stroke="currentColor">
    <circle r="8.5" cy="9" cx="9" stroke-opacity="0.2"/>
    <path d="M6.82972 6.82915L1.17193 1.17097" stroke-linecap="round" stroke-linejoin="round" transform="translate(5 5)"/>
    <path d="M1.22896 6.88502L6.77288 1.11523" stroke-linecap="round" stroke-linejoin="round" transform="translate(5 5)"/>
  </symbol>

  <symbol id="icon-close" class="icon icon-close" fill="none" viewBox="0 0 18 17">
    <path d="M.865 15.978a.5.5 0 00.707.707l7.433-7.431 7.579 7.282a.501.501 0 00.846-.37.5.5 0 00-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 10-.707-.708L8.991 7.853 1.413.573a.5.5 0 10-.693.72l7.563 7.268-7.418 7.417z" fill="currentColor"/>
  </symbol>
</svg>

{% comment %} AliExpress-style Header Wrapper {% endcomment %}
<{% if section.settings.sticky_header_type != 'none' %}sticky-header data-sticky-type="{{ section.settings.sticky_header_type }}"{% else %}div{% endif %} class="header-wrapper color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}">
  
  <!-- AliExpress Custom Element Wrapper -->
  <aliexpress-header>
    <!-- AliExpress Top Header -->
    <header class="alx-header" id="alx-main-header">
    <div class="page-width alx-header__container">
      <!-- Left: Logo -->
      <div class="alx-header__left">
        <a href="{{ routes.root_url }}" class="alx-header__logo link focus-inset">
          {%- if settings.logo != blank -%}
            {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
            {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
            {{ settings.logo | image_url: width: 200 | image_tag:
              class: 'alx-header__logo-image',
              widths: '50, 100, 150, 200',
              height: logo_height,
              width: settings.logo_width,
              alt: logo_alt
            }}
          {%- else -%}
            <span class="alx-header__logo-text h2">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>

      <!-- Center: Search Bar -->
      <div class="alx-header__center">
        {%- if settings.predictive_search_enabled -%}
          <predictive-search class="alx-search-form" data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- else -%}
          <search-form class="alx-search-form">
        {%- endif -%}
          <form action="{{ routes.search_url }}" method="get" role="search" class="alx-search">
            <div class="alx-search__field">
              <input class="alx-search__input"
                id="alx-search-input"
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="Tìm kiếm sản phẩm..."
                {%- if settings.predictive_search_enabled -%}
                  role="combobox"
                  aria-expanded="false"
                  aria-owns="predictive-search-results"
                  aria-controls="predictive-search-results"
                  aria-haspopup="listbox"
                  aria-autocomplete="list"
                  autocorrect="off"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                {%- endif -%}
              >
              <input type="hidden" name="options[prefix]" value="last">
              <button type="submit" class="alx-search__button" aria-label="{{ 'general.search.search' | t }}">
                <svg class="alx-search__icon" viewBox="0 0 18 19" fill="none">
                  <use href="#icon-search">
                </svg>
                Tìm kiếm
              </button>
            </div>
            
            {%- if settings.predictive_search_enabled -%}
              <div class="alx-predictive-search" tabindex="-1" data-predictive-search>
                <div class="alx-predictive-search__loading">
                  <svg class="spinner" viewBox="0 0 66 66">
                    <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                  </svg>
                </div>
              </div>
              <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
            {%- endif -%}
          </form>
        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- else -%}
          </search-form>
        {%- endif -%}
      </div>

      <!-- Right: Language/Currency, Account, Cart -->
      <div class="alx-header__right">
        <!-- Language/Currency -->
        <div class="alx-header__locale">
          {%- if localization.available_languages.size > 1 or localization.available_countries.size > 1 -%}
            <details class="alx-locale-selector">
              <summary class="alx-locale-selector__toggle" aria-label="{{ 'general.language_currency' | t }}">
                <svg class="alx-icon alx-icon--globe" width="20" height="20" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="2" y1="12" x2="22" y2="12"/>
                  <path d="m16.24 7.76-1.8 5.41-1.8-5.41m1.8 5.41H8.76m3.24-5.41v5.41m0 0l1.8-5.41"/>
                </svg>
                <span class="alx-locale-text">{{ localization.language.endonym_name }} / {{ localization.country.currency.symbol }}</span>
              </summary>
              <div class="alx-locale-selector__dropdown">
                {%- if localization.available_languages.size > 1 -%}
                  <div class="alx-locale-section">
                    <h3>{{ 'general.language' | t }}</h3>
                    {%- for language in localization.available_languages -%}
                      <a href="#" class="alx-locale-option{% if language.iso_code == localization.language.iso_code %} alx-locale-option--current{% endif %}" data-value="{{ language.iso_code }}">
                        {{ language.endonym_name }}
                      </a>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                {%- if localization.available_countries.size > 1 -%}
                  <div class="alx-locale-section">
                    <h3>{{ 'general.currency' | t }}</h3>
                    {%- for country in localization.available_countries -%}
                      <a href="#" class="alx-locale-option{% if country.iso_code == localization.country.iso_code %} alx-locale-option--current{% endif %}" data-value="{{ country.iso_code }}">
                        {{ country.currency.symbol }} {{ country.currency.iso_code }}
                      </a>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            </details>
          {%- else -%}
            <div class="alx-locale-display">
              <svg class="alx-icon alx-icon--globe" width="20" height="20" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <path d="m16.24 7.76-1.8 5.41-1.8-5.41m1.8 5.41H8.76m3.24-5.41v5.41m0 0l1.8-5.41"/>
              </svg>
              <span>{{ localization.language.endonym_name }} / {{ localization.country.currency.symbol }}</span>
            </div>
          {%- endif -%}
        </div>

        <!-- Account -->
        {%- if shop.customer_accounts_enabled -%}
          <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="alx-header__account link focus-inset">
            <svg class="alx-icon alx-icon--account" width="24" height="24" viewBox="0 0 24 24">
              <circle cx="12" cy="8" r="4"/>
              <path d="M4 20c0-4 8-4 8-4s8 0 8 4"/>
            </svg>
            <span class="alx-account-text">
              {%- if customer -%}
                {{ 'customer.account_fallback' | t }}
              {%- else -%}
                {{ 'customer.log_in' | t }}
              {%- endif -%}
            </span>
          </a>
        {%- endif -%}

        <!-- Cart -->
        <a href="{{ routes.cart_url }}" class="alx-header__cart link focus-inset" id="alx-cart-icon">
          <div class="alx-cart__wrapper">
            <svg class="alx-icon alx-icon--cart" width="24" height="24" viewBox="0 0 24 24">
              {%- if cart == empty -%}
                <circle cx="9" cy="21" r="1"/>
                <circle cx="20" cy="21" r="1"/>
                <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
              {%- else -%}
                <circle cx="9" cy="21" r="1"/>
                <circle cx="20" cy="21" r="1"/>
                <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
              {%- endif -%}
            </svg>
            {%- if cart != empty -%}
              <span class="alx-cart__count">{{ cart.item_count }}</span>
            {%- endif -%}
          </div>
          <span class="alx-cart-text">{{ 'templates.cart.cart' | t }}</span>
        </a>
      </div>
    </div>
  </header>
    
  <!-- AliExpress Mega Menu Bar -->
  {%- if section.settings.menu != blank -%}
    <nav class="alx-mega-menu-bar" id="alx-mega-menu">
      <div class="page-width alx-mega-menu-bar__container">
        <!-- All Categories Button -->
        <div class="alx-categories-dropdown">
          <button class="alx-categories-trigger" aria-expanded="false" aria-controls="alx-categories-menu">
            <svg class="alx-icon alx-icon--menu" width="20" height="20" viewBox="0 0 24 24">
              <rect x="3" y="6" width="18" height="2"/>
              <rect x="3" y="12" width="18" height="2"/>
              <rect x="3" y="18" width="18" height="2"/>
            </svg>
            <span>Tất cả danh mục</span>
            <svg class="alx-icon alx-icon--caret" width="16" height="16" viewBox="0 0 16 16">
              <path d="M4 6l4 4 4-4"/>
            </svg>
          </button>

          <!-- Categories Sidebar -->
          <div class="alx-categories-menu" id="alx-categories-menu">
            <div class="alx-categories-sidebar">
              <ul class="alx-categories-list">
                {%- if section.settings.menu != blank and section.settings.menu.links.size > 0 -%}
                  {%- for link in section.settings.menu.links -%}
                    <li class="alx-category-item" data-category="{{ forloop.index }}">
                      <a href="{{ link.url }}" class="alx-category-link">
                        <span class="alx-category-title">{{ link.title | escape }}</span>
                        {%- if link.links != blank -%}
                          <svg class="alx-icon alx-icon--arrow" width="16" height="16" viewBox="0 0 16 16">
                            <path d="M6 4l4 4-4 4"/>
                          </svg>
                        {%- endif -%}
                      </a>
                    </li>
                  {%- endfor -%}
                {%- else -%}
                  <!-- FALLBACK SIDEBAR CATEGORIES -->
                  <li class="alx-category-item active" data-category="1">
                    <a href="/collections/all" class="alx-category-link">
                      <span class="alx-category-title">Tất cả sản phẩm</span>
                      <svg class="alx-icon alx-icon--arrow" width="16" height="16" viewBox="0 0 16 16">
                        <path d="M6 4l4 4-4 4"/>
                      </svg>
                    </a>
                  </li>
                  <li class="alx-category-item" data-category="2">
                    <a href="/collections" class="alx-category-link">
                      <span class="alx-category-title">Bộ sưu tập</span>
                      <svg class="alx-icon alx-icon--arrow" width="16" height="16" viewBox="0 0 16 16">
                        <path d="M6 4l4 4-4 4"/>
                      </svg>
                    </a>
                  </li>
                  <li class="alx-category-item" data-category="3">
                    <a href="/pages/about" class="alx-category-link">
                      <span class="alx-category-title">Về chúng tôi</span>
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            </div>

            <!-- Mega Menu Content -->
            <div class="alx-mega-menu-content">
              {%- if section.settings.menu != blank and section.settings.menu.links.size > 0 -%}
                {%- for link in section.settings.menu.links -%}
                  {%- if link.links != blank -%}
                    <div id="MegaMenu-Content-{{ forloop.index }}" class="mega-menu__panel alx-mega-menu-panel" tabindex="-1" role="menu" aria-labelledby="HeaderMenu-{{ link.title | handleize }}" data-category="{{ forloop.index }}" style="display: {% if forloop.first %}block{% else %}none{% endif %}; z-index: 2147483647;">
                      <div class="alx-mega-menu-grid">
                        {%- for childlink in link.links -%}
                          <div class="alx-mega-menu-column">
                            <h4 class="alx-mega-menu-heading">
                              <a href="{{ childlink.url }}">{{ childlink.title | escape }}</a>
                            </h4>
                            {%- if childlink.links != blank -%}
                              <ul class="alx-mega-menu-list">
                              {%- for grandchildlink in childlink.links -%}
                                <li class="alx-mega-menu-item">
                                  <a href="{{ grandchildlink.url }}" class="alx-mega-menu-link">
                                    {{ grandchildlink.title | escape }}
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </div>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                <!-- ALWAYS SHOW FALLBACK CONTENT - Menu not configured -->
                <div id="MegaMenu-Content-1" class="mega-menu__panel alx-mega-menu-panel" tabindex="-1" role="menu" aria-labelledby="HeaderMenu-fallback" data-category="1" style="display: block !important; visibility: visible !important; opacity: 1 !important; background: white !important; padding: 20px !important; z-index: 2147483647 !important;">
                  <div class="alx-mega-menu-grid">
                    <div class="alx-mega-menu-column">
                      <h4 class="alx-mega-menu-heading">Danh mục sản phẩm</h4>
                      <ul class="alx-mega-menu-list">
                        <li class="alx-mega-menu-item">
                          <a href="/collections/all" class="alx-mega-menu-link">Tất cả sản phẩm</a>
                        </li>
                        <li class="alx-mega-menu-item">
                          <a href="/collections" class="alx-mega-menu-link">Bộ sưu tập</a>
                        </li>
                        <li class="alx-mega-menu-item">
                          <a href="/pages/about" class="alx-mega-menu-link">Về chúng tôi</a>
                        </li>
                        <li class="alx-mega-menu-item">
                          <a href="/search" class="alx-mega-menu-link">Tìm kiếm</a>
                        </li>
                      </ul>
                    </div>
                    <div class="alx-mega-menu-column">
                      <h4 class="alx-mega-menu-heading">Hỗ trợ khách hàng</h4>
                      <ul class="alx-mega-menu-list">
                        <li class="alx-mega-menu-item">
                          <a href="/pages/contact" class="alx-mega-menu-link">Liên hệ</a>
                        </li>
                        <li class="alx-mega-menu-item">
                          <a href="/pages/shipping" class="alx-mega-menu-link">Chính sách vận chuyển</a>
                        </li>
                        <li class="alx-mega-menu-item">
                          <a href="/pages/returns" class="alx-mega-menu-link">Đổi trả</a>
                        </li>
                        <li class="alx-mega-menu-item">
                          <a href="/pages/faq" class="alx-mega-menu-link">FAQ</a>
                        </li>
                      </ul>
                    </div>
                    <div class="alx-mega-menu-column">
                      <h4 class="alx-mega-menu-heading">Khuyến mãi</h4>
                      <ul class="alx-mega-menu-list">
                        <li class="alx-mega-menu-item">
                          <a href="/collections/sale" class="alx-mega-menu-link">Sản phẩm giảm giá</a>
                        </li>
                        <li class="alx-mega-menu-item">
                          <a href="/collections/new" class="alx-mega-menu-link">Sản phẩm mới</a>
                        </li>
                        <li class="alx-mega-menu-item">
                          <a href="/collections/featured" class="alx-mega-menu-link">Nổi bật</a>
                        </li>
                        <li class="alx-mega-menu-item">
                          <a href="/collections/bestseller" class="alx-mega-menu-link">Bán chạy</a>
                        </li>
                      </ul>
                    </div>
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>

        <!-- Additional Navigation Links (Optional) -->
        <div class="alx-nav-links">
          <!-- You can add additional navigation links here if needed -->
        </div>
      </div>
    </nav>
  {%- endif -%}
  </aliexpress-header>

  <!-- Mobile Menu Drawer -->
  {%- if section.settings.menu != blank -%}
    <header-drawer data-breakpoint="tablet">
      <details id="Details-menu-drawer-container" class="alx-menu-drawer-container">
        <summary class="alx-mobile-menu-trigger" aria-label="{{ 'sections.header.menu' | t }}">
          <svg class="alx-icon alx-icon--hamburger" width="24" height="24" viewBox="0 0 24 24">
            <rect x="3" y="6" width="18" height="2"/>
            <rect x="3" y="12" width="18" height="2"/>
            <rect x="3" y="18" width="18" height="2"/>
          </svg>
          <svg class="alx-icon alx-icon--close hidden" width="24" height="24" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </summary>
        
        <div id="alx-mobile-menu" class="alx-mobile-menu gradient motion-reduce" tabindex="-1">
          <div class="alx-mobile-menu__container">
            <div class="alx-mobile-menu__header">
              <h3 class="alx-mobile-menu__title">Menu</h3>
              <button class="alx-mobile-menu__close">
                <svg class="alx-icon" width="24" height="24" viewBox="0 0 24 24">
                  <line x1="18" y1="6" x2="6" y2="18"/>
                  <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
              </button>
            </div>
            
            <!-- Mobile Navigation -->
            <nav class="alx-mobile-nav">
              <ul class="alx-mobile-nav__menu">
                {%- for link in section.settings.menu.links -%}
                  <li class="alx-mobile-nav__item">
                    {%- if link.links != blank -%}
                      <details class="alx-mobile-accordion">
                        <summary class="alx-mobile-accordion__trigger">
                          <span>{{ link.title | escape }}</span>
                          <svg class="alx-icon alx-icon--caret" width="16" height="16" viewBox="0 0 16 16">
                            <path d="M4 6l4 4 4-4"/>
                          </svg>
                        </summary>
                        <div class="alx-mobile-accordion__content">
                          <ul class="alx-mobile-submenu">
                            {%- for childlink in link.links -%}
                              <li class="alx-mobile-submenu__item">
                                {%- if childlink.links == blank -%}
                                  <a href="{{ childlink.url }}" class="alx-mobile-submenu__link">
                                    {{ childlink.title | escape }}
                                  </a>
                                {%- else -%}
                                  <details class="alx-mobile-subaccordion">
                                    <summary class="alx-mobile-subaccordion__trigger">
                                      <span>{{ childlink.title | escape }}</span>
                                      <svg class="alx-icon alx-icon--caret" width="12" height="12" viewBox="0 0 16 16">
                                        <path d="M4 6l4 4 4-4"/>
                                      </svg>
                                    </summary>
                                    <div class="alx-mobile-subaccordion__content">
                                      <ul class="alx-mobile-subsubmenu">
                                        {%- for grandchildlink in childlink.links -%}
                                          <li class="alx-mobile-subsubmenu__item">
                                            <a href="{{ grandchildlink.url }}" class="alx-mobile-subsubmenu__link">
                                              {{ grandchildlink.title | escape }}
                                            </a>
                                          </li>
                                        {%- endfor -%}
                                      </ul>
                                    </div>
                                  </details>
                                {%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </details>
                    {%- else -%}
                      <a href="{{ link.url }}" class="alx-mobile-nav__link">
                        {{ link.title | escape }}
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </nav>

            <!-- Social Links in Mobile Menu -->
            <div class="alx-mobile-social">
              <ul class="alx-social-list">
                {%- if settings.social_facebook_link != blank -%}
                  <li class="alx-social-item">
                    <a href="{{ settings.social_facebook_link }}" class="alx-social-link">
                      {%- render 'icon-facebook' -%}
                      <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_instagram_link != blank -%}
                  <li class="alx-social-item">
                    <a href="{{ settings.social_instagram_link }}" class="alx-social-link">
                      {%- render 'icon-instagram' -%}
                      <span class="visually-hidden">{{ 'general.social.links.instagram' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_youtube_link != blank -%}
                  <li class="alx-social-item">
                    <a href="{{ settings.social_youtube_link }}" class="alx-social-link">
                      {%- render 'icon-youtube' -%}
                      <span class="visually-hidden">{{ 'general.social.links.youtube' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            </div>
          </div>
        </div>
      </details>
    </header-drawer>
  {%- endif -%}



n toàn, không câu hỏi nào được đặt ra.<\/p>","layout":"image_first","height":"adapt","desktop_content_alignment":"center","desktop_image_width":"medium","desktop_font_size":35,"mobile_font_size":25,"font_size":16,"heading_color":"#ffffff","heading_highlighted_color":"#000000","body_color":"#ffffff","body_highlighted_color":"#000000","section_color_scheme":"accent-3","padding_top":0,"padding_bottom":0}},"borders_RFA3ND":{"type":"borders","settings":{"shape":"curved","border_size":"60","flip_horizontal":true,"flip_vertical":true,"shape_color":"base-accent-3","enable_custom_shape_color":false,"custom_shape_color":"","background_color":"base-accent-2","padding_top":0,"padding_bottom":0}},"collapsible_content_Nf9Rhk":{"type":"collapsible-content","blocks":{"collapsible_row_qW4UHd":{"type":"collapsible_row","settings":{"heading":"Bàn này có dễ vệ sinh không?","row_content":"<p>Có, bề mặt sơn PU cao cấp giúp bạn dễ dàng lau chùi, giữ cho bàn luôn sạch sẽ và mới mẻ mà không tốn quá nhiều thời gian.<\/p>","show_custom_icon":true,"icon":"<svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" height=\"24px\" viewBox=\"0 -960 960 960\" width=\"24px\" fill=\"#1f1f1f\"><path d=\"M478-240q21 0 35.5-14.5T528-290q0-21-14.5-35.5T478-340q-21 0-35.5 14.5T428-290q0 21 14.5 35.5T478-240Zm-36-154h74q0-33 7.5-52t42.5-52q26-26 41-49.5t15-56.5q0-56-41-86t-97-30q-57 0-92.5 30T342-618l66 26q5-18 22.5-39t53.5-21q32 0 48 17.5t16 38.5q0 20-12 37.5T506-526q-44 39-54 59t-10 73Zm38 314q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z\"\/><\/svg>","heading_color":"#383838","heading_highlighted_color":"#383838","body_color":"#302f2f","body_highlighted_color":"#302f2f"}},"collapsible_row_DfEV3X":{"type":"collapsible_row","settings":{"heading":"Kích thước bàn có phù hợp cho không gian nhỏ không?","row_content":"<p>Kích thước rộng rãi của bàn này giúp tối ưu không gian làm việc. Tuy nhiên, nếu bạn có không gian hạn chế, hãy đảm bảo đo đạc cẩn thận trước khi quyết định nhé!<\/p>","show_custom_icon":true,"icon":"<svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" height=\"24px\" viewBox=\"0 -960 960 960\" width=\"24px\" fill=\"#1f1f1f\"><path d=\"M478-240q21 0 35.5-14.5T528-290q0-21-14.5-35.5T478-340q-21 0-35.5 14.5T428-290q0 21 14.5 35.5T478-240Zm-36-154h74q0-33 7.5-52t42.5-52q26-26 41-49.5t15-56.5q0-56-41-86t-97-30q-57 0-92.5 30T342-618l66 26q5-18 22.5-39t53.5-21q32 0 48 17.5t16 38.5q0 20-12 37.5T506-526q-44 39-54 59t-10 73Zm38 314q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z\"\/><\/svg>","heading_color":"#383838","heading_highlighted_color":"#383838","body_color":"#302f2f","body_highlighted_color":"#302f2f"}},"collapsible_row_t3hVnQ":{"type":"collapsible_row","settings":{"heading":"Chất liệu của bàn có bền lâu không?","row_content":"<p>Chất liệu bền bỉ kết hợp với công nghệ sơn PU chống trầy xước giúp bàn duy trì vẻ đẹp và độ bền cao theo thời gian, là lựa chọn lý tưởng cho văn phòng.<\/p>","show_custom_icon":true,"icon":"<svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" height=\"24px\" viewBox=\"0 -960 960 960\" width=\"24px\" fill=\"#1f1f1f\"><path d=\"M478-240q21 0 35.5-14.5T528-290q0-21-14.5-35.5T478-340q-21 0-35.5 14.5T428-290q0 21 14.5 35.5T478-240Zm-36-154h74q0-33 7.5-52t42.5-52q26-26 41-49.5t15-56.5q0-56-41-86t-97-30q-57 0-92.5 30T342-618l66 26q5-18 22.5-39t53.5-21q32 0 48 17.5t16 38.5q0 20-12 37.5T506-526q-44 39-54 59t-10 73Zm38 314q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 
0 129 24t109 66.5Q766-707 797-649t40 126l3 52q19 9 29.5 27t10.5 38v92q0 20-10.5 38T840-249v49q0 33-23.5 56.5T760-120H440Zm-80-280q-17 0-28.5-11.5T320-440q0-17 11.5-28.5T360-480q17 0 28.5 11.5T400-440q0 17-11.5 28.5T360-400Zm240 0q-17 0-28.5-11.5T560-440q0-17 11.5-28.5T600-480q17 0 28.5 11.5T640-440q0 17-11.5 28.5T600-400Zm-359-62q-7-106 64-182t177-76q89 0 156.5 56.5T720-519q-91-1-167.5-49T435-698\"\/><\/svg>","layout":"horizontal","icon_size":"medium","font_size":14,"text_color":"#000000","custom_icon_color":"#000000","padding_top":10,"padding_bottom":10}},"collapsible_tab_TgYBPV":{"type":"collapsible_tab","settings":{"heading":"Mô tả","content":"<p>Mang đến sự hoàn hảo trong thiết kế hiện đại, sản phẩm của chúng tôi không chỉ đẹp mắt mà còn cực kỳ bền bỉ và dễ bảo trì.<ul><li>Bề mặt sơn PU cao cấp bóng mịn<\/li><li>Chống trầy xước hiệu quả, bền bỉ theo thời gian<\/li><li>Kích thước rộng rãi tối ưu không gian làm việc<\/li><li>Phù hợp cho không gian văn phòng lãnh đạo<\/li><\/ul><\/p>","collapsible_font_size":16,"coll_heading_color":"#000000","coll_heading_highlighted_color":"#000000","coll_text_color":"#000000","coll_text_highlighted_color":"#000000","collapsible_background_color_scheme_open":"accent-1","collapsible_border_radius":10,"padding_top":3,"padding_bottom":3}},"collapsible_tab_KnRaMB":{"type":"collapsible_tab","settings":{"heading":"Câu hỏi Thường Gặp Nhất","content":"<p><b>Câu hỏi 1:<\/b> Chất liệu sơn PU có bền không?<br\/><b>Trả lời 1:<\/b> Chất liệu sơn PU được sử dụng không chỉ mang lại vẻ đẹp sang trọng mà còn có độ bền cao, chống trầy xước tốt và dễ dàng lau chùi, đảm bảo giữ gìn vẻ mới lâu dài cho sản phẩm.<br\/><br\/><b>Câu hỏi 2:<\/b> Kích thước bàn có đủ lớn để làm việc không?<br\/><b>Trả lời 2:<\/b> Bàn có kích thước rộng rãi, cho phép tối ưu không gian làm việc, đảm bảo bạn có đủ chỗ để sắp xếp tài liệu và thiết bị cần thiết trong quá trình làm việc.<br\/><br\/><b>Câu hỏi 3:<\/b> Bàn có phù hợp cho không gian văn phòng nhỏ không?<br\/><b>Trả lời 3:<\/b> Mặc dù bàn có kích thước rộng, nhưng với thiết kế hiện đại, nó hoàn toàn có thể được điều chỉnh và bổ sung cho không gian văn phòng nhỏ, tạo nên sự sang trọng mà không cảm thấy chật chội.<\/p>","collapsible_font_size":16,"coll_heading_color":"#000000","coll_heading_highlighted_color":"#000000","coll_text_color":"#000000","coll_text_highlighted_color":"#000000","collapsible_background_color_scheme_open":"accent-1","collapsible_border_radius":10,"padding_top":3,"padding_bottom":3}},"collapsible_tab_r4cHmp":{"type":"collapsible_tab","settings":{"heading":"Xử lý & Vận chuyển","content":"<p>Chúng tôi cung cấp Vận chuyển Đặt Nhanh miễn phí cho tất cả các đơn hàng! Vui lòng cho chúng tôi từ 1-2 ngày làm việc để xử lý và gửi đơn hàng của bạn. Thời gian dự kiến đến: 7-12 ngày làm việc.<\/p>","collapsible_font_size":16,"coll_heading_color":"#000000","coll_heading_highlighted_color":"#000000","coll_text_color":"#000000","coll_text_highlighted_color":"#000000","collapsible_background_color_scheme_open":"accent-1","collapsible_border_radius":10,"padding_top":3,"padding_bottom":3}},"reviews_NM8tEB":{"type":"reviews","settings":{"text_1":"Insert review here","author_1":"Nguyễn Anh","author_location_1":"Los Angeles","text_2":"Insert review here","author_2":"Trần Minh","author_location_2":"Los Angeles","text_3":"Insert review here","author_3":"Lê Thị","author_location_3":"Los Angeles","show_stars":true,"show_verified_text":false,"mini_review_stars_color":"#f3d94f","color_scheme":"accent-1","padding_top":0,"padding_bottom":0}},"sticky_atc_Uaw4AC":{"type":"sticky_atc","settings":{"button_label":"Thêm vào giỏ hàng","display_when":"after_scroll","show_price_badge":true,"show_variant_selector":true,"show_price":true,"show_compare_at_price":true,"price_size":20,"comp_price_size":18,"bold_sticky_atc_text":false,"price_color":"#000000","compare_price_color":"#000000","button_color_scheme":"accent-3","button_text_color":"#ffffff","color_scheme":"accent-2","padding_top":0,"padding
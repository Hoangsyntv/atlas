 -960 960 960\" width=\"24px\" fill=\"#1f1f1f\"><path d=\"M440-120v-80h320v-284q0-117-81.5-198.5T480-764q-117 0-198.5 81.5T200-484v244h-40q-33 0-56.5-23.5T80-320v-80q0-21 10.5-39.5T120-469l3-53q8-68 39.5-126t79-101q47.5-43 109-67T480-840q68 0 129 24t109 66.5Q766-707 797-649t40 126l3 52q19 9 29.5 27t10.5 38v92q0 20-10.5 38T840-249v49q0 33-23.5 56.5T760-120H440Zm-80-280q-17 0-28.5-11.5T320-440q0-17 11.5-28.5T360-480q17 0 28.5 11.5T400-440q0 17-11.5 28.5T360-400Zm240 0q-17 0-28.5-11.5T560-440q0-17 11.5-28.5T600-480q17 0 28.5 11.5T640-440q0 17-11.5 28.5T600-400Zm-359-62q-7-106 64-182t177-76q89 0 156.5 56.5T720-519q-91-1-167.5-49T435-698\"><\/path><\/svg>","layout":"horizontal","icon_size":"medium","font_size":14,"text_color":"#000000","custom_icon_color":"#000000","padding_top":10,"padding_bottom":10}},"collapsible_tab_TgYBPV":{"type":"collapsible_tab","settings":{"heading":"Mô tả","content":"<p>Nâng tầm không gian làm việc của bạn với chiếc ghế xoay lưới GL119 sang trọng và chức năng, kết hợp giữa thiết kế hiện đại và tiện ích vượt trội, phù hợp cho dân văn phòng và các chuyên gia.<ul><li>Thiết kế lưới giúp thoáng khí, thoải mái khi ngồi lâu<\/li><li>Khung ghế chắc chắn, hỗ trợ điều chỉnh độ cao linh hoạt<\/li><li>Cơ cấu xoay tiện lợi, tạo điều kiện làm việc hiệu quả<\/li><li>Ghế dễ dàng lắp ráp với đầy đủ dụng cụ kèm theo<\/li><\/ul><\/p>","collapsible_font_size":16,"coll_heading_color":"#000000","coll_heading_highlighted_color":"#000000","coll_text_color":"#000000","coll_text_highlighted_color":"#000000","collapsible_background_color_scheme_open":"accent-1","collapsible_border_radius":10,"padding_top":3,"padding_bottom":3}},"collapsible_tab_KnRaMB":{"type":"collapsible_tab","settings":{"heading":"Câu Hỏi Thường Gặp","content":"<p><b>Câu Hỏi 1:<\/b> Kích thước của ghế này là gì và nó có hỗ trợ được trọng lượng lớn không?<br\/><b>Trả Lời 1:<\/b> Ghế xoay lưới GL119 được thiết kế với kích thước tối ưu cho không gian làm việc, đồng thời có khả năng chịu trọng lượng lớn, phù hợp cho nhiều người dùng khác nhau.<br\/><br\/><b>Câu Hỏi 2:<\/b> Ghế có dễ lắp ráp không?<br\/><b>Trả Lời 2:<\/b> Việc lắp ráp ghế rất đơn giản với các hướng dẫn rõ ràng và đầy đủ dụng cụ đi kèm. Nhiều khách hàng cho biết họ có thể hoàn tất lắp đặt nhanh chóng và bắt đầu sử dụng ngay lập tức.<br\/><br\/><b>Câu Hỏi 3:<\/b> Ghế này có phù hợp cho cả công việc văn phòng và sử dụng giải trí không?<br\/><b>Trả Lời 3:<\/b> Có, ghế xoay lưới GL119 rất linh hoạt, vừa thích hợp cho môi trường làm việc chuyên nghiệp, vừa lý tưởng cho những giờ phút giải trí thoải mái. Thiết kế lưới cùng khung ghế chắc chắn giúp nâng cao sự thoải mái và hiệu quả trong suốt thời gian sử dụng.<\/p>","collapsible_font_size":16,"coll_heading_color":"#000000","coll_heading_highlighted_color":"#000000","coll_text_color":"#000000","coll_text_highlighted_color":"#000000","collapsible_background_color_scheme_open":"accent-1","collapsible_border_radius":10,"padding_top":3,"padding_bottom":3}},"collapsible_tab_r4cHmp":{"type":"collapsible_tab","settings":{"heading":"Vận Chuyển","content":"<p>Chúng tôi cung cấp dịch vụ Giao Hàng Nhanh miễn phí cho tất cả các đơn hàng! Vui lòng cho phép 1-2 Ngày Làm Việc để chúng tôi xử lý và giao hàng cho bạn. Thời gian ước tính đến nơi: 7-12 ngày làm việc.<\/p>","collapsible_font_size":16,"coll_heading_color":"#000000","coll_heading_highlighted_color":"#000000","coll_text_color":"#000000","coll_text_highlighted_color":"#000000","collapsible_background_color_scheme_open":"accent-1","collapsible_border_radius":10,"padding_top":3,"padding_bottom":3}},"reviews_NM8tEB":{"type":"reviews","settings":{"text_1":"Ghế GL119 mang lại sự thoáng khí và thoải mái tuyệt đối.","author_1":"{Name}","author_location_1":"Los Angeles","text_2":"Thiết kế xoay linh hoạt giúp tăng năng suất làm việc nhanh chóng.","author_2":"{Name}","author_location_2":"Los Angeles","text_3":"Khung chắc chắn và chất liệu lưới bền bỉ cho sử dụng lâu dài.","author_3":"{Name}","author_location_3":"Los Angeles","show_stars":true,"show_verified_text":false,"mini_review_stars_color":"#f3d94f","color_scheme":"accent-1","padding_top":0,"padding_bottom":0}},"sticky_atc_Uaw4AC":{"type":"sticky_atc","settings":{"button_label":"Add to cart","display_when":"after_scroll","show_price_badge":true,"show_variant_selector":true,"show_price":true,"show_compare_at_price":true,"title_size":15,"option_size":13,"price_size":20,"comp_price_size":18,"bold_sticky_atc_text":false,"product_title_color":"#000000","product_option_color":"#000000","price_color":"#000000","compare_price_color":"#000000","button_color_scheme":"accent-3","button_text_color":"#ffffff","color_scheme":"accent-2","padding_top":0,"padding_bottom":0}}},"block_order":["title","rating_HWTnKx","description","text_ALmAKK","price","text_KVYqTW","bullet-point-benefits","44f9cdc2-f4bf-466e-87d5-fb765ad4864a","atlas_ai_store_builder_bundler_hJrXjQ","buy_buttons","inventory_ePVkFn","text_QwxdBm","estimated_arrival_date","icon_with_text_CyFfFf","collapsible_tab_TgYBPV","collapsible_tab_KnRaMB","collapsible_tab_r4cHmp","reviews_NM8tEB","sticky_atc_Uaw4AC"],"settings":{"enable_sticky_info":true,"gallery_layout":"thumbnail_slider","media_size":"small","media_fit":"contain","show_main_image_first":false,"thumbnail_border_radius":10,"mobile_media_height":"large","mobile_media_ratio":"fill","mobile_thumbnails":"show","mobile_thumb_size":"small","image_zoom":"none","enable_video_looping":false,"media_badge_position":"top-right","media_badge_size":"medium","section_color_scheme":"accent-1","padding_top":12,"padding_bottom":0}},"horizontal_scrolling_text_mgft6H":{"type":"horizontal-scrolling-text","blocks":{"text_bhKVK4":{"type":"text","settings":{"title":"Giao hàng nhanh chóng"}},"text_WjTjtc":{"type":"text","settings":{"title":"Mua sắm không lo ngại"}},"text_hfPTxT":{"type":"text","settings":{"title":"An toàn khi ngồi"}},"text_PnmK77":{"type":"text","settings":{"title":"Tiện lợi và thoải mái"}}},"block_order":["text_bhKVK4","text_WjTjtc","t